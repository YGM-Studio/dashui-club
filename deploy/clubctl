#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
cd /srv/dashui-club
exec 9>/run/lock/dashui-club-control.lock
flock -n 9 || { echo 'Another club operation is running.' >&2; exit 1; }
compose=(docker compose --project-name dashui-club --env-file .env -f compose.cn.yaml)
switch_location() {
    install -m 0644 "$1" active-location.conf.next
    mv active-location.conf.next active-location.conf
    nginx -t
    systemctl reload nginx
}
wait_status() {
    for attempt in {1..30}; do
        code=$(curl --noproxy '*' --resolve club.1gemo.com:443:127.0.0.1 --silent --output /dev/null --write-out '%{http_code}' "https://club.1gemo.com$2")
        [[ "$code" == "$1" ]] && return 0
        sleep 0.2
    done
    echo 'Nginx did not reach the expected state.' >&2
    return 1
}
wait_local_health() {
    for attempt in {1..60}; do
        if curl --max-time 2 --fail --silent http://127.0.0.1:3031/api/health >/dev/null; then
            return 0
        fi
        sleep 0.5
    done
    echo 'Application did not become healthy.' >&2
    return 1
}
case "${1:-status}" in
    stop)
        switch_location offline-location.conf
        wait_status 503 /
        "${compose[@]}" stop app
        echo 'Community stopped. Database and images are retained; no backup was created.'
        ;;
    start)
        "${compose[@]}" start app
        wait_local_health
        curl --fail --silent --show-error http://127.0.0.1:3031/api/health
        switch_location online-location.conf
        wait_status 200 /api/health
        ;;
    status)
        "${compose[@]}" ps -a
        du -sh data
        ;;
    *) echo 'Usage: clubctl {status|stop|start}' >&2; exit 2 ;;
esac
